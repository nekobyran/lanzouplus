    <string name="onboarding_welcome_plus">欢迎使用 LanzouPlus</string>
    <string name="onboarding_intro">蓝奏云资源浏览、搜索与下载工具。开始前了解必要权限，验证一组可解析的蓝奏云链接与 UA，并选择更新通道。设置完成后直接进入主界面。</string>
    <string name="onboarding_start">开始设置</string>
    <string name="onboarding_permissions_title">授权由你决定</string>
    <string name="onboarding_permissions_body">下载到公共目录、更新安装和管理本地文件可使用“管理所有文件”权限。电池优化豁免有助于后台下载持续运行。</string>
    <string name="onboarding_permissions_optional">以上两项均可跳过；主界面不再自动弹出申请。需要时可在“设置”页主动授权。</string>
